# Dawned-Admin environment (production: /etc/dawned/admin.env, written by the
# game repo's DEPLOY.sh). Every value has a dev default — an empty env works
# against the game repo's local dev database.

NODE_ENV=development
HOST=127.0.0.1
PORT=8082

# The game's PostgreSQL (the game repo owns migrations).
DATABASE_URL=postgres://dawned:dawned@127.0.0.1:5432/dawned

# Game server base URL: public health probes + localhost ops API.
GAME_OPS_URL=http://127.0.0.1:8081
# Must match the game server's OPS_SECRET.
OPS_SECRET=dev-only-ops-secret-change-me

LOG_LEVEL=info
